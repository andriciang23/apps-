# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; must match the Meta webhook config page
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > Settings > Basic.
# REQUIRED. The service refuses to start without it: the owner allowlist is the
# only other defence, and an unverified payload can claim to be from any number.
META_APP_SECRET=

# ── Who may talk to the assistant ────────────────────────────────────────────
# Comma-separated, digits only (country code included, no +). Andri and Mun Yan.
# Anyone not listed here reaches no tool, no ledger and no file.
OWNER_PHONE_NUMBERS=

# ── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=hojichaya.myshopify.com
# From the Shopify Dev Dashboard (dev.shopify.com/dashboard) > your app > Settings.
#
# NOT a shpat_... token. Shopify stopped allowing new admin-created custom apps on
# 1 Jan 2026; apps now exchange these two values for a token that lasts 24 hours,
# which the app refreshes on its own. There is nothing to paste in daily.
#
# The app version needs these scopes: read_products, read_customers,
# read_inventory, write_draft_orders.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── Claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Ops bridge (ops-mcp) ─────────────────────────────────────────────────────
# Absolute path to ops-mcp/server.py
OPS_MCP_SERVER=C:\Claude\apps\ops-mcp\server.py
# Full python path — a bare `python` can hit the Microsoft Store stub
OPS_MCP_PYTHON=C:\Users\firec\AppData\Local\Programs\Python\Python312\python.exe
# Read by ops-mcp itself; the directory holding facts.py / velocity.py / paths.py
HOJICHAYA_TOOLS_DIR=C:\Claude\tools

# ── File registry ────────────────────────────────────────────────────────────
# Root for every path in files.registry.json. Nothing outside it can be sent.
FILE_REGISTRY_ROOT=C:\Claude\SendableFiles
