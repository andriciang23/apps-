# Server
PORT=3000

# Meta WhatsApp Cloud API
# Found in Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret, used to verify webhook signatures (recommended)
META_APP_SECRET=

# Shopify
# e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Admin API access token from a custom app with write_draft_orders + read_products scopes
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Claude (order parsing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
